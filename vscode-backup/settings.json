    ],
    "file:///home/glitchy_moon/.vscode/extensions/continue.continue-1.2.19-linux-x64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ],
    "file:///home/glitchy_moon/.vscode/extensions/continue.continue-1.2.21-linux-x64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ],
    "file:///home/glitchy_moon/.vscode/extensions/continue.continue-1.2.22-linux-x64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ]
  },
  "terminal.integrated.commandsToSkipShell": [
    "kilo-code.new.agentManagerOpen",
    "kilo-code.new.agentManager.showTerminal"
  ],
  "kilo-code.new.showTaskTimeline": true
}
